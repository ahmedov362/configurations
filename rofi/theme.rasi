* {
    fg:       @foreground;
    accent:   @selected-normal-background;
    urgent:   @urgent-background;
    
    background-color: transparent;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    background-color: rgba(30, 30, 46, 0.85);
    border: 2px solid;
    border-color: @accent;
    border-radius: 14px;
    width: 500px;
    padding: 15px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 15px;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 10px;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    background-color: transparent;
    placeholder: "Поиск...";
    placeholder-color: @fg;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    spacing: 5px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 10px;
    border-radius: 6px;
    spacing: 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
