@import "wallust/colors-rofi.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
    font:             "FantasqueSansM Nerd Font Mono Bold 12";
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @accent;
    border-radius:    16px;
    width:            520px;
    padding:          20px;
    location:         center;
    anchor:           center;
    transparency:     "real";
}

mainbox {
    children: [inputbar, listview];
    spacing:  16px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          12px;
    orientation:      horizontal;
    children:         [prompt, entry];
}

prompt {
    text-color:  @accent;
    font:        "FantasqueSansM Nerd Font Mono Bold 12";
    padding:     0 12px 0 0;
    expand:      false;
}

entry {
    cursor:  text;
    expand:  true;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      4px;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

element {
    padding:       10px 14px;
    border-radius: 8px;
    spacing:       12px;
    cursor:        pointer;
}

element normal normal {
    text-color: @fg;
}

element normal urgent,
element normal active {
    text-color: @accent;
}

element selected normal,
element selected urgent,
element selected active {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:              22px;
    vertical-align:    0.5;
    background-color:  transparent;
    text-color:        inherit;
    padding:           0 4px 0 0;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold;
}

message {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px;
}

textbox {
    text-color: @fg;
}

