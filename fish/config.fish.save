# ═══ ПАКЕТЫ ═══
alias install='sudo dnf install'
alias remove='sudo dnf remove'
alias clean='sudo dnf autoremove'
alias update='sudo dnf upgrade --refresh'
alias search='dnf search'

# ═══ НАВИГАЦИЯ ═══
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias h='cd ~'
alias projects='cd ~/Projects/'

# ═══ ФАЙЛЫ (lsd вместо ls) ═══
alias ls='lsd'
alias l='lsd -lFh'
alias la='lsd -laFh'
alias lr='lsd -R'
alias usage='du -sh * | sort -h'
alias space='df -h'

# ═══ ТЕКСТ (bat вместо cat) ═══
alias cat='bat'

# ═══ ПОИСК ═══
alias find='fd'
alias grep='rg'

# ═══ СИСТЕМА ═══
alias top='btop'
alias clr='clear'
alias myip='curl ifconfig.me'
alias pinggoogle='ping -c 5 8.8.8.8'
alias fetch='fastfetch'

# ═══ PYTHON ═══
alias py='python3'
alias pyversion='python3 --version'

# ═══ GIT ═══
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias lg='lazygit'

# ═══ РЕДАКТОРЫ ═══
alias vim='nvim'
alias efish='nvim ~/.config/fish/config.fish'
alias sfish='source ~/.config/fish/config.fish'

# ═══ ПРОЕКТЫ (пути обновлены!) ═══
alias qwen='cd ~/Projects/FreeQwenApi && npm start'
alias h-go='cd ~/.hermes/agent && uv run hermes gateway run --replace'
alias h-chat='cd ~/.hermes/agent && uv run hermes'

# ═══ ZOXIDE (умный cd) ═══
zoxide init fish | source

# ═══ FZF ═══
fzf --fish | source

# ═══ PATH ═══
fish_add_path ~/.local/bin
fish_add_path ~/.hermes/agent
alias theme='qs -c noctalia-shell ipc call wallpaper random eDP-1 && sleep 2 && python3 ~/.config/scripts/theme.py'
alias lf="yazi"
function wt
    python ~/Projects/weather/weather.py
end
function clock 
