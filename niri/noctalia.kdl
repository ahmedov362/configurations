layout {

    focus-ring {
        active-color   "#6799e4"
        inactive-color "#101c2d"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6799e4"
        inactive-color "#101c2d"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#101c2d70"
    }

    tab-indicator {
        active-color   "#6799e4"
        inactive-color "#0c3f8d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6799e480"
    }
}

recent-windows {
    highlight {
        active-color "#6799e4"
        urgent-color "#fd4663"
    }
}
