{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch_small",
        "padding": {
            "top": 1,
            "left": 2
        },
        "printRemaining": false
    },
    "display": {
        "separator": " ",
        "disableLinewrap": true
    },
    "modules": [
        { "type": "custom", "key": "╭───────────╮" },
        {
            "type": "title",
            "key": "│ {#31} User    {#keys}│",
            "format": "{user-name}"
        },
        {
            "type": "host",
            "key": "│ \u001b[1;34m   Host   {#keys}│",
            "format": "{host-name}"
        },
        {
            "type": "os",
            "key": "│ {#34}{icon} Distro  {#keys}│"
        },
        {
            "type": "kernel",
            "key": "│ {#35} Kernel  {#keys}│"
        },
        {
            "type": "uptime",
            "key": "│ {#33}   Uptime  {#keys}│"
        },
        {
            "type": "de",
            "key": "│ {#36}   Desktop {#keys}│"
        },
        {
            "type": "wm",
            "key": "│ {#36} WM      {#keys}│"
        },
        {
            "type": "terminal",
            "key": "│ {#31} Terminal{#keys}│"
        },
        {
            "type": "shell",
            "key": "│ {#32} Shell   {#keys}│"
        },
        {
            "type": "terminalfont",
            "key": "│ {#32} Font    {#keys}│"
        },
        {
            "type": "cursor",
            "key": "│ {#33} Cursor  {#keys}│"
        },
        {
            "type": "cpu",
            "key": "│ {#33}   CPU     {#keys}│",
            "format": "{name}",
            "outputTruncateLength": 22
        },
        {
            "type": "gpu",
            "key": "│ {#34}   GPU     {#keys}│",
            "outputTruncateLength": 22
        },
        {
            "type": "memory",
            "key": "│ {#36} Memory  {#keys}│"
        },
        {
            "type": "swap",
            "key": "│ {#32}   Swap    {#keys}│"
        },
        {
            "type": "disk",
            "key": "│ {#34}   Disk    {#keys}│",
            "folders": "/"
        },
        {
            "type": "packages",
            "key": "│ {#33}   Pkgs    {#keys}│"
        },
        {
            "type": "bluetooth",
            "key": "│ {#31} BlueT   {#keys}│"
        },
        {
            "type": "display",
            "key": "│ {#35}   Display {#keys}│"
        },
        {
            "type": "player",
            "key": "│ {#35}   Player  {#keys}│",
            "outputTruncateLength": 22
        },
        {
            "type": "media",
            "key": "│ {#35}   Music   {#keys}│",
            "outputTruncateLength": 22
        },
        { "type": "custom", "key": "├───────────┤" },
        {
            "type": "colors",
            "key": "│ {#39} Colors  {#keys}│",
            "symbol": "circle"
        },
        { "type": "custom", "key": "╰───────────╯" }
    ]
}

